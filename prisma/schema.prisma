datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String       @id @default(cuid())
  email     String       @unique
  name      String?
  trades    TradeEntry[] @relation("UserTrades")
  account   Account?
  tradingPlan     TradingPlan?
  journals        Journal[]
  coachingReports CoachingReport[]
  createdAt       DateTime     @default(now())

  stripeCustomerId     String?   @unique
  subscriptionId       String?
  subscriptionStatus   String?   @default("free")
  subscriptionPlan     String?   @default("free")
  subscriptionEndDate  DateTime?

  aiCoachingUsed       Int       @default(0)
  aiAnalysisUsed       Int       @default(0)
  aiChartUsed          Int       @default(0)
}

model Account {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A trader's standing rules: account size, per-position sizing, exit targets,
/// and a win-rate kill switch. One row per user; trades since startDate are
/// measured against it.
model TradingPlan {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  startingBalance Float
  startDate       DateTime @db.Date

  riskPct         Float // max % of account in one position
  takeProfitPct   Float // target gain on a position
  stopLossPct     Float // max loss on a position
  targetWinRate   Float // % the plan assumes
  maxTradesPerDay Int?

  killWindow  Int   @default(20) // rolling closed-trade window
  killFloor   Float @default(45) // win-rate % below which the kill switch trips
  killRiskPct Float @default(1) // position size % while the switch is on

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TradeEntry {
  id     String @id @default(cuid())
  user   User   @relation("UserTrades", fields: [userId], references: [id])
  userId String

  ticker         String
  strategy       String?
  positionType   String
  optionType     String?
  strike         Float?
  expiry         DateTime?
  entryDate      DateTime
  entryTime      String?
  sellDate       DateTime?
  exitTime       String?
  maxRisk        Float?
  notes          String?
  outcome        TradeOutcome? @map("outcome")
  chartUrl       String?
  aiAnalysis     String?       @db.Text
  tags           String[]      @default([])

  buyFills     Json?
  sellFills    Json?
  totalBuyQty  Int?
  totalSellQty Int?
  avgBuyPrice  Float?
  avgSellPrice Float?
  realizedPnl  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  legs TradeLeg[] @relation("TradeLegs")

  @@index([userId])
  @@index([userId, entryDate])
}

model TradeLeg {
  id      String     @id @default(cuid())
  trade   TradeEntry @relation("TradeLegs", fields: [tradeId], references: [id])
  tradeId String

  type     OptionType
  action   LegAction
  strike   Float
  expiry   DateTime
  quantity Int
  price    Float

  @@index([tradeId])
}

model Journal {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String
  date   DateTime @db.Date

  premarketPlan  String? @db.Text
  watchlist      String[]  @default([])
  marketBias     String?
  keyLevels      String? @db.Text
  postReview     String? @db.Text
  lessonsLearned String? @db.Text
  mood           Int?
  confidence     Int?
  grade          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model CoachingReport {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  date      DateTime @db.Date
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

enum OptionType {
  CALL
  PUT
}

enum TradeOutcome {
  PROFIT
  LOSS
}

enum LegAction {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
  ROLLED
  PARTIAL
}
