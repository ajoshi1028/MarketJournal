datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String       @id @default(cuid())
  email     String       @unique
  name      String?
  trades    TradeEntry[] @relation("UserTrades")
  createdAt DateTime     @default(now())
}

model TradeEntry {
  id            String     @id @default(cuid())
  user          User       @relation("UserTrades", fields: [userId], references: [id])
  userId        String

  // core fields
  ticker        String
  strategy      String?
  positionType  String                // "LONG" | "SHORT" in your app layer
  entryDate     DateTime
  sellDate      DateTime?             // <-- NEW (optional)               // you can keep this if you still want the single-entry field
  maxRisk       Float?
  notes         String?
  outcome       TradeOutcome? @map("outcome")

  // fills & derived metrics
  buyFills      Json?                 // [{ qty: number, price: number }, ...]
  sellFills     Json?                 // [{ qty: number, price: number }, ...]
  totalBuyQty   Int?                  // sum of buy qty
  totalSellQty  Int?                  // sum of sell qty
  avgBuyPrice   Float?                // weighted average buy price
  avgSellPrice  Float?                // weighted average sell price
  realizedPnl   Float?                // dollars, using 100x option multiplier

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  legs          TradeLeg[] @relation("TradeLegs")
}

model TradeLeg {
  id         String      @id @default(cuid())
  trade      TradeEntry  @relation("TradeLegs", fields: [tradeId], references: [id])
  tradeId    String

  type       OptionType
  action     LegAction
  strike     Float
  expiry     DateTime
  quantity   Int
  price      Float
}

enum OptionType {
  CALL
  PUT
}

enum TradeOutcome {
  PROFIT
  LOSS
}

enum LegAction {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
  ROLLED
  PARTIAL
}
