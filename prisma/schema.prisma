// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String       @id @default(cuid())
  email     String       @unique
  name      String?
  trades    TradeEntry[] @relation("UserTrades")
  account   Account?
  createdAt DateTime     @default(now())
}

model Account {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  // store as Float for simplicity; switch to Decimal if you prefer
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TradeEntry {
  id     String @id @default(cuid())
  user   User   @relation("UserTrades", fields: [userId], references: [id])
  userId String

  // core fields
  ticker         String
  strategy       String?
  positionType   String
  entryDate      DateTime
  sellDate       DateTime?
  maxRisk        Float?
  notes          String?
  outcome        TradeOutcome? @map("outcome")
  chartUrl       String?
  aiAnalysis     String?       @db.Text
  
  // fills & derived metrics
  buyFills     Json?
  sellFills    Json?
  totalBuyQty  Int?
  totalSellQty Int?
  avgBuyPrice  Float?
  avgSellPrice Float?
  realizedPnl  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  legs TradeLeg[] @relation("TradeLegs")
}

model TradeLeg {
  id      String     @id @default(cuid())
  trade   TradeEntry @relation("TradeLegs", fields: [tradeId], references: [id])
  tradeId String

  type     OptionType
  action   LegAction
  strike   Float
  expiry   DateTime
  quantity Int
  price    Float
}

enum OptionType {
  CALL
  PUT
}

enum TradeOutcome {
  PROFIT
  LOSS
}

enum LegAction {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
  ROLLED
  PARTIAL
}
