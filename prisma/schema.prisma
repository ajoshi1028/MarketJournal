datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String       @id @default(cuid())
  email     String       @unique
  name      String?
  trades    TradeEntry[] @relation("UserTrades")
  account   Account?
  journals        Journal[]
  coachingReports CoachingReport[]
  createdAt       DateTime     @default(now())

  stripeCustomerId     String?   @unique
  subscriptionId       String?
  subscriptionStatus   String?   @default("free")
  subscriptionPlan     String?   @default("free")
  subscriptionEndDate  DateTime?
}

model Account {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TradeEntry {
  id     String @id @default(cuid())
  user   User   @relation("UserTrades", fields: [userId], references: [id])
  userId String

  ticker         String
  strategy       String?
  positionType   String
  optionType     String?
  strike         Float?
  expiry         DateTime?
  entryDate      DateTime
  entryTime      String?
  sellDate       DateTime?
  exitTime       String?
  maxRisk        Float?
  notes          String?
  outcome        TradeOutcome? @map("outcome")
  chartUrl       String?
  aiAnalysis     String?       @db.Text
  tags           String[]      @default([])

  buyFills     Json?
  sellFills    Json?
  totalBuyQty  Int?
  totalSellQty Int?
  avgBuyPrice  Float?
  avgSellPrice Float?
  realizedPnl  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  legs TradeLeg[] @relation("TradeLegs")
}

model TradeLeg {
  id      String     @id @default(cuid())
  trade   TradeEntry @relation("TradeLegs", fields: [tradeId], references: [id])
  tradeId String

  type     OptionType
  action   LegAction
  strike   Float
  expiry   DateTime
  quantity Int
  price    Float
}

model Journal {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String
  date   DateTime @db.Date

  premarketPlan  String? @db.Text
  watchlist      String[]  @default([])
  marketBias     String?
  keyLevels      String? @db.Text
  postReview     String? @db.Text
  lessonsLearned String? @db.Text
  mood           Int?
  confidence     Int?
  grade          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model CoachingReport {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  date      DateTime @db.Date
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

enum OptionType {
  CALL
  PUT
}

enum TradeOutcome {
  PROFIT
  LOSS
}

enum LegAction {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
  ROLLED
  PARTIAL
}
